++  await runTest('Proposal Milestone Editing & Rate Re-calculation', async () => {
++    const patchRes = await fetch(`${BASE_URL}/api/gigs/proposals/${proposalId}/status`, {
++      method: 'PATCH',
++      headers: { 'Content-Type': 'application/json' },
