++name: Daily Freelance Project Discovery & Quality Check
++
++on:
++  schedule:
++    # Runs daily at 08:00 UTC (1:30 PM IST)
++    - cron: '0 8 * * *'
++  workflow_dispatch: # Allows manual trigger from GitHub Actions tab
++
++jobs:
++  discover-and-verify:
++    name: Run Automated Discovery & Verification
++    runs-on: ubuntu-latest
++
++    steps:
++      - name: Checkout Code
++        uses: actions/checkout@v4
++
++      - name: Set up Node.js 22
++        uses: actions/setup-node@v4
++        with:
++          node-version: 22
++          cache: 'npm'
++
++      - name: Install Dependencies
++        run: npm install
++
++      - name: Generate Prisma Types
++        run: npm run db:generate
++
++      - name: Run E2E Automation Suite
++        run: npm test
++
++      - name: Summary
++        run: |
++          echo "Daily Freelancer Project Discovery & Verification completed successfully."
++          echo "Time: $(date -u)"
+diff --git a/apps/api/src/gigs/discovery/project-discovery.service.ts b/apps/api/src/gigs/discovery/project-discovery.service.ts
+index 46b89d0..da23724 100644
+--- a/apps/api/src/gigs/discovery/project-discovery.service.ts
++++ b/apps/api/src/gigs/discovery/project-discovery.service.ts
+@@ -19,6 +19,13 @@ export class ProjectDiscoveryService {
+   async onModuleInit() {
+     // Run initial discovery pass on boot
+     await this.syncDiscoveredGigs();
++
++    // Automatically re-scan permitted feeds every 6 hours (4 times daily)
++    setInterval(() => {
++      this.syncDiscoveredGigs().catch((err) =>
++        this.logger.error(`Automated daily discovery background error: ${err}`),
++      );
++    }, 1000 * 60 * 60 * 6);
+   }
+ 
+   async syncDiscoveredGigs(): Promise<{ added: number; total: number }> {
+diff --git a/apps/web/app/api/cron/daily-discovery/route.ts b/apps/web/app/api/cron/daily-discovery/route.ts
+new file mode 100644
+index 0000000..4d5089d
+--- /dev/null
++++ b/apps/web/app/api/cron/daily-discovery/route.ts
+@@ -0,0 +1,31 @@
++import { NextResponse } from 'next/server';
++import { getGigs, getProfile, scoreGig } from '@/lib/freelancer-data';
++
++export async function GET(req: Request) {
++  // Can be called by Vercel Cron, GitHub Actions, or Railway scheduled worker
++  const profile = getProfile();
++  const gigs = getGigs();
++
++  const scoredMatches = gigs.map((gig) => {
++    const evaluation = scoreGig(profile, gig);
++    return {
++      title: gig.title,
++      client: gig.clientName,
++      winnabilityScore: evaluation.score,
++      matchedSkills: evaluation.matchedSkills,
++      url: gig.sourceUrl,
++    };
++  });
++
++  return NextResponse.json({
++    status: 'success',
++    message: 'Automated daily discovery check completed successfully.',
++    totalOpportunitiesScanned: gigs.length,
++    highWinnabilityCount: scoredMatches.filter((m) => m.winnabilityScore >= 80).length,
++    timestamp: new Date().toISOString(),
++  });
++}
++
++export async function POST(req: Request) {
++  return GET(req);
++}
