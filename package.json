{
  "name": "autonomous-job-hunter",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:api": "npm run start:dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace=api --if-present",
    "lint": "npx tsc --noEmit --project apps/web/tsconfig.json",
    "db:generate": "npm run prisma:generate --workspace=api",
    "db:migrate": "npm run prisma:migrate --workspace=api",
    "db:studio": "npm run prisma:studio --workspace=api"
  }
}